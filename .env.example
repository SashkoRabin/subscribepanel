# Required server-side Supabase Postgres connection string. Use the direct connection
# for migrations and the pooler connection for serverless application traffic.
SUPABASE_DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Required by browser code only when a feature uses Supabase's browser SDK. This key
# is publishable; Row Level Security is still mandatory on every exposed table.
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Do not expose this to the browser. Not currently needed by the app.
SUPABASE_SERVICE_ROLE_KEY=

# Required for production Better Auth sessions. Generate a high-entropy secret; never commit it.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional: enables Google OAuth only when both values are configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: used later by worker integrations. Keep provider credentials server-side only.
OPENAI_API_KEY=
RESEND_API_KEY=

