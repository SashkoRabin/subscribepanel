# Required Supabase project URL and publishable API key. The publishable key is
# safe for browser use only when Row Level Security protects every exposed table.
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only Postgres connection string for Drizzle migrations and web queries.
SUPABASE_DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# Server-only Supabase secret key. Never prefix it with NEXT_PUBLIC or commit it.
SUPABASE_SECRET_KEY=sb_secret_...

# Optional: used later by worker integrations. Keep provider credentials server-side only.
OPENAI_API_KEY=
RESEND_API_KEY=

