{
  "name": "subscript",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm --filter @subscript/web dev",
    "dev:all": "turbo run dev",
    "start": "pnpm --filter @subscript/web start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @subscript/database db:generate",
    "db:migrate": "pnpm --filter @subscript/database db:migrate"
  },
  "devDependencies": {
    "turbo": "2.11.10",
    "typescript": "5.9.3"
  }
}

